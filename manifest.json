{
  "manifest_version": 3,
  "name": "SOMA Schedule Helper",
  "version": "0.1.2",
  "description": "소마 특강과 구글 캘린더 일정을 비교해 보여주는 확장프로그램",
  "icons": {
    "16": "icons/image.png",
    "32": "icons/image.png",
    "48": "icons/image.png",
    "128": "icons/image.png"
  },
  "key": "",
  "permissions": ["storage", "identity", "alarms", "offscreen"],
  "host_permissions": [
    "https://swmaestro.ai/*",
    "https://www.swmaestro.ai/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/image.png",
      "32": "icons/image.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://swmaestro.ai/sw/mypage/mentoLec/list.do*",
        "https://www.swmaestro.ai/sw/mypage/mentoLec/list.do*"
      ],
      "js": ["src/content/parsers.js", "src/content/lecture-status.js", "src/content/content.js"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://swmaestro.ai/sw/mypage/mentoLec/view.do*",
        "https://www.swmaestro.ai/sw/mypage/mentoLec/view.do*"
      ],
      "js": ["src/content/parsers.js", "src/content/lecture-status.js", "src/content/apply.js"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://swmaestro.ai/sw/mypage/userAnswer/history.do*",
        "https://www.swmaestro.ai/sw/mypage/userAnswer/history.do*"
      ],
      "js": ["src/content/parsers.js", "src/content/history.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "oauth2": {
    "client_id": "139276301420-je68kup5of498j42lqle1evirqpi3ugf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events"
    ]
  }
}
