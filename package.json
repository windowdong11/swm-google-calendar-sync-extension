{
  "name": "soma-schedule-helper",
  "version": "0.1.2",
  "private": true,
  "description": "SOMA Schedule Helper Chrome extension",
  "type": "commonjs",
  "scripts": {
    "test": "node --test",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.js",
